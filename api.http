### REGISTER USER
POST http://localhost:3000/api/v1/auth/register
Content-Type: application/json

{
  "name": "Diogo Vasconcelos",
  "email": "Vasconcelos.pb@compasso.com.br",
  "password": "12345678"
}

> {% client.global.set("email", response.body.email); %}

### LOGIN USER
POST http://localhost:3000/api/v1/auth/login
Content-Type: application/json

{
  "email": "Vasconcelos.pb@compasso.com.br",
  "password": "12345678"
}

> {% client.global.set("token", response.body.token); %}

### ALL CARS
GET http://localhost:3000/api/v1/cars

### ALL CARS WITH FILTER
GET http://localhost:3000/api/v1/cars?brand=ar

### ALL CARS WITH FILTER
GET http://localhost:3000/api/v1/cars?year=2019

### ALL CARS WITH FILTER
GET http://localhost:3000/api/v1/cars?year=2019&brand=Marca

### FIND CARS
GET http://localhost:3000/api/v1/cars/10

### CREATE CAR
POST http://localhost:3000/api/v1/cars
Content-Type: application/json
#Authorization: Bearer {{token}}

{
  "brand": "Marca7",
  "model": "Modelo7",
  "year": 2024,
  "plate": "AYY-1D01"
}

> {% client.global.set("carId", response.body.id); %}

### CREATE ITENS
PUT http://localhost:3000/api/v1/cars/9/items
Content-Type: application/json


  [
    "Ar condicionado1",
    "Trava Eletrica1",
    "Vidro Eletrico1"
  ]

### UPDATE CAR
PATCH http://localhost:3000/api/v1/cars/100
Content-type: application/json

{
  "brand": "Marca",
  "model": "Modelo",
  "year": 2080
}

### DELETE CAR
DELETE http://localhost:3000/api/v1/cars/1
